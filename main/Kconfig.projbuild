menu "PearlPod"
config PEARL_BUTTON_UP
    int "Volume-up / power GPIO"
    range 0 48
    default 0
config PEARL_BUTTON_DOWN
    int "Volume-down / screen lock GPIO"
    range 0 48
    default 48
config PEARL_HIGH_IMPEDANCE_OUTPUT
    bool "2 Vrms output for headphones of at least 600 ohms"
    default n
    help
        Enables the CS43131 high-voltage full-scale mode. Requires headphones
        of at least 600 ohms and a DAC VP supply of at least 3.3 V. Leave off
        for ordinary headphones: their maximum supported range is 1.41 Vrms.
        Both modes use 0 dB DAC volume and unity PCM gain at volume 100.
endmenu

menu "Listener power management"
config PEARL_SCREEN_TIMEOUT_SEC
    int "Screen sleep after inactivity (seconds, 0 disables)"
    range 0 3600
    default 45
config PEARL_IDLE_SLEEP_SEC
    int "Deep sleep when paused and idle (seconds, 0 disables)"
    range 0 7200
    default 300
config PEARL_BRIGHTNESS
    int "OLED brightness (16-255)"
    range 16 255
    default 192
config PEARL_WIFI_SETUP_SEC
    int "WiFi setup session lifetime (seconds)"
    range 60 3600
    default 300
config PEARL_WIFI_DIAGNOSTIC_SEC
    int "Connected diagnostic session lifetime (seconds)"
    range 60 3600
    default 900
endmenu
